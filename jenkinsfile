pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Downloading code from GitHub'

                git branch: 'mybranch',
                    url: 'https://github.com/kavima101-netizen/myrepo.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Checking HTML file'

                sh 'test -f welcome.html'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying HTML to Apache server'

                sshagent(credentials: ['server1-sshkey']) {
                    sh '''
                        scp -o StrictHostKeyChecking=yes \
                        welcome.html ec2-user@172.31.23.140:/tmp/welcome.html

                        ssh -o StrictHostKeyChecking=yes \
                        ec2-user@172.31.23.140 \
                        'sudo install -m 644 /tmp/welcome.html /var/www/html/welcome.html'
                    '''
                }
            }
        }

    }
}



